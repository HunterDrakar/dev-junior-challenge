# Copie para .env (na pasta api) e ajuste se precisar.

# Porta da API
PORT=3000

# Serviço externo de cadastro (mock-service)
CADASTRO_URL=http://localhost:4000

# Sites que podem chamar a API pelo navegador (separe vários por vírgula)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Opcional: com esta linha a fila vai para o PostgreSQL; comentada, fica em memória.
# DATABASE_URL=postgres://desafio:desafio@localhost:5432/checkin
